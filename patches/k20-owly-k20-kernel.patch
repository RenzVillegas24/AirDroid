diff --git a/drivers/staging/qcacld-3.0/core/wma/inc/wma_frame_inject.h b/drivers/staging/qcacld-3.0/core/wma/inc/wma_frame_inject.h
new file mode 100644
index 000000000..f670b9593
--- /dev/null
+++ b/drivers/staging/qcacld-3.0/core/wma/inc/wma_frame_inject.h
@@ -0,0 +1,51 @@
+/*
+ * Minimal WiFi frame injection support for monitor-mode interfaces.
+ *
+ * QCACLD-3.0 firmware silently drops management-frame TX from a monitor-type
+ * vdev. The only vdev types firmware accepts mgmt TX from are AP and STA.
+ *
+ * The obvious fix -- hand-roll a second vdev via raw WMI calls
+ * (vdev_create/vdev_start/peer_create) -- crashes the firmware/host: those
+ * calls alone skip a huge amount of state the real vdev lifecycle sets up
+ * (CDP datapath attach, objmgr vdev object, PE/SME session, and more found
+ * by reading wma_vdev_attach() in wma_dev_if.c and hdd_vdev_create() in
+ * wlan_hdd_main.c). Rather than keep reimplementing that piece by piece,
+ * the hidden vdev is created via the driver's own proven adapter-creation
+ * path (hdd_open_adapter() + hdd_start_adapter(), the same functions that
+ * create wlan1/p2p0 at boot) -- see hdd_inject_get_tx_vdev_id() in
+ * wlan_hdd_main.c. This file's only job is sending a frame given an
+ * already-valid vdev_id, through the same WMI mgmt-TX path real management
+ * frames already use (wmi_mgmt_unified_cmd_send).
+ */
+#ifndef __WMA_FRAME_INJECT_H
+#define __WMA_FRAME_INJECT_H
+
+#include "qdf_status.h"
+
+/*
+ * Deliberately does NOT include "wma.h" here: that header (and what it pulls
+ * in, e.g. cds_ieee80211_common.h) conflicts with net/ieee80211_radiotap.h's
+ * IEEE80211_CHAN_* macros, which callers outside wma/ (namely
+ * wlan_hdd_main.c) already have included. Callers pass the WMA handle as an
+ * opaque void*; wma_frame_inject.c itself includes wma.h and casts it to
+ * tp_wma_handle internally, where that conflict doesn't arise.
+ */
+
+/**
+ * wma_inject_frame_via_vdev() - send a raw 802.11 frame through the WMI
+ * mgmt-TX path, tagged with an already-valid (non-monitor-type) vdev
+ * @wma_handle: WMA handle (opaque here; see note above)
+ * @tx_vdev_id: vdev id to send as -- must be a real, already-started,
+ *              non-monitor-type vdev (see wlan_hdd_main.c for how one gets
+ *              created for this purpose)
+ * @frame: raw 802.11 frame bytes (starting at the frame control field, no
+ *         radiotap header)
+ * @frame_len: length of frame in bytes
+ *
+ * Return: QDF_STATUS_SUCCESS if the frame was handed to firmware (does not
+ * guarantee it was actually transmitted over the air).
+ */
+QDF_STATUS wma_inject_frame_via_vdev(void *wma_handle, uint8_t tx_vdev_id,
+				      uint8_t *frame, uint32_t frame_len);
+
+#endif /* __WMA_FRAME_INJECT_H */
diff --git a/drivers/staging/qcacld-3.0/core/wma/src/wma_frame_inject.c b/drivers/staging/qcacld-3.0/core/wma/src/wma_frame_inject.c
new file mode 100644
index 000000000..c994ef593
--- /dev/null
+++ b/drivers/staging/qcacld-3.0/core/wma/src/wma_frame_inject.c
@@ -0,0 +1,116 @@
+/*
+ * See wma_frame_inject.h for the approach and why it's shaped this way.
+ * Vdev creation lives in wlan_hdd_main.c now (hdd_inject_get_tx_vdev_id());
+ * this file only builds and sends the WMI mgmt-TX command.
+ */
+#include "wma.h"
+#include "wma_api.h"
+#include "cds_api.h"
+#include "wmi_unified_api.h"
+#include "wmi_unified.h"
+#include "qdf_nbuf.h"
+#include "qdf_types.h"
+#include "qdf_mem.h"
+#include "../inc/wma_frame_inject.h"
+#include "wlan_objmgr_vdev_obj.h"
+#include "wlan_objmgr_peer_obj.h"
+#include "wlan_mgmt_txrx_utils_api.h"
+
+QDF_STATUS wma_inject_frame_via_vdev(void *wma_context, uint8_t tx_vdev_id,
+				      uint8_t *frame, uint32_t frame_len)
+{
+	tp_wma_handle wma_handle = (tp_wma_handle)wma_context;
+	struct wmi_mgmt_params mgmt_param;
+	qdf_nbuf_t wmi_buf;
+	uint8_t *frame_data;
+	struct wlan_objmgr_vdev *vdev;
+	struct wlan_objmgr_peer *self_peer;
+	QDF_STATUS status;
+
+	if (!wma_handle || !frame || !frame_len) {
+		WMA_LOGE("wma_inject: invalid parameters");
+		return QDF_STATUS_E_INVAL;
+	}
+	if (tx_vdev_id >= wma_handle->max_bssid ||
+	    !wma_handle->interfaces[tx_vdev_id].vdev_active) {
+		WMA_LOGE("wma_inject: tx vdev %u not active", tx_vdev_id);
+		return QDF_STATUS_E_INVAL;
+	}
+
+	/*
+	 * Send through the driver's own mgmt-txrx path (wlan_mgmt_txrx_mgmt_
+	 * frame_tx) rather than calling wmi_mgmt_unified_cmd_send() directly.
+	 * That matters for a subtle reason: the WMI mgmt-TX command DMA-maps the
+	 * frame nbuf and hands it to firmware, and the nbuf is only unmapped and
+	 * freed later, from the mgmt-TX *completion* handler, keyed by the
+	 * descriptor id echoed back by firmware. Sending directly left every
+	 * injected frame with desc_id 0 and no registered descriptor, so its
+	 * completion could never be matched ("Mgmt desc empty for id 0" in
+	 * dmesg) and the mapped nbuf leaked -- after a few thousand injected
+	 * frames the mgmt-TX descriptor pool exhausts and ALL mgmt TX (deauth/
+	 * assoc) silently stalls until a reboot. Going through mgmt-txrx
+	 * allocates a real descriptor, so the completion frees the nbuf and
+	 * releases the descriptor; with NULL completion callbacks the handler
+	 * simply frees the nbuf. See notes/03-injection.md.
+	 *
+	 * The path needs an objmgr vdev + its self-peer (the completion handler
+	 * unconditionally releases a peer ref, so a valid peer is required); the
+	 * hidden injection adapter is a real STA vdev, so it has a self-peer.
+	 */
+	vdev = wlan_objmgr_get_vdev_by_id_from_psoc(wma_handle->psoc, tx_vdev_id,
+						    WLAN_LEGACY_WMA_ID);
+	if (!vdev) {
+		WMA_LOGE("wma_inject: no objmgr vdev for vdev %u", tx_vdev_id);
+		return QDF_STATUS_E_INVAL;
+	}
+	self_peer = wlan_vdev_get_selfpeer(vdev);
+	if (!self_peer) {
+		WMA_LOGE("wma_inject: no self peer for vdev %u", tx_vdev_id);
+		wlan_objmgr_vdev_release_ref(vdev, WLAN_LEGACY_WMA_ID);
+		return QDF_STATUS_E_INVAL;
+	}
+
+	wmi_buf = qdf_nbuf_alloc(NULL, frame_len, 0, 0, false);
+	if (!wmi_buf) {
+		WMA_LOGE("wma_inject: qdf_nbuf_alloc failed");
+		wlan_objmgr_vdev_release_ref(vdev, WLAN_LEGACY_WMA_ID);
+		return QDF_STATUS_E_NOMEM;
+	}
+	frame_data = qdf_nbuf_put_tail(wmi_buf, frame_len);
+	if (!frame_data) {
+		qdf_nbuf_free(wmi_buf);
+		wlan_objmgr_vdev_release_ref(vdev, WLAN_LEGACY_WMA_ID);
+		return QDF_STATUS_E_NOMEM;
+	}
+	qdf_mem_copy(frame_data, frame, frame_len);
+
+	qdf_mem_zero(&mgmt_param, sizeof(mgmt_param));
+	mgmt_param.tx_frame = wmi_buf;
+	mgmt_param.frm_len = frame_len;
+	mgmt_param.vdev_id = tx_vdev_id;
+	mgmt_param.chanfreq = 0; /* match how real probe requests are sent */
+	mgmt_param.pdata = frame_data;
+	mgmt_param.qdf_ctx = cds_get_context(QDF_MODULE_ID_QDF_DEVICE);
+	mgmt_param.tx_params_valid = false;
+	mgmt_param.use_6mbps = 0;
+
+	/* NULL download/OTA completion callbacks => the completion handler just
+	 * frees the nbuf. mgmt-txrx takes its own peer ref for the lifetime of
+	 * the frame, so our vdev ref can be dropped as soon as this returns.
+	 */
+	status = wlan_mgmt_txrx_mgmt_frame_tx(self_peer, NULL, wmi_buf,
+					      NULL, NULL,
+					      WLAN_UMAC_COMP_MGMT_TXRX,
+					      &mgmt_param);
+	WMA_LOGD("wma_inject: sent frame len=%u via vdev=%u, status=%d",
+		 frame_len, tx_vdev_id, status);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		WMA_LOGE("wma_inject: mgmt_frame_tx failed: %d", status);
+		/* On failure mgmt-txrx/WMI leave the frame nbuf for the caller
+		 * (it is unmapped but not freed there) -- free it here.
+		 */
+		qdf_nbuf_free(wmi_buf);
+	}
+	wlan_objmgr_vdev_release_ref(vdev, WLAN_LEGACY_WMA_ID);
+	return status;
+}
diff --git a/include/linux/compiler_types.h b/include/linux/compiler_types.h
index 0286b26c2..604520b60 100644
